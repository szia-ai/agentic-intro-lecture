{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "UV_NO_SYNC": "1"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(uv run --no-sync ruff *)",
      "Bash(uv run --no-sync ty *)",
      "Bash(uv run --no-sync pytest *)"
    ],
    "ask": [
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv pip install *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(uv lock *)",
      "Bash(uv sync *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": ["~/.cache/uv"],
      "allowRead": [".env", ".env.example"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/format_edited_file.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
